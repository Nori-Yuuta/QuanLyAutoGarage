@model List<AutoGarageMVC.Models.Entities.TradeInValuation>
@{
    Layout = "_AdminLayout";
    ViewBag.Heading = "Quản Lý Định Giá Xe Cũ & Thu Cũ Đổi Mới";
}

<div class="admin-card">
  <div class="tab-header">
    <div>
      <h2 style="margin:0 0 4px 0">Danh Sách Hồ Sơ Thẩm Định Xe Cũ</h2>
      <small style="color:#666">Tổng cộng: @Model.Count hồ sơ cần thẩm định giá thu mua</small>
    </div>
  </div>

  @if (Model != null && Model.Any())
  {
    <div style="overflow-x:auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Khách Hàng</th>
            <th>Mẫu Xe Cũ</th>
            <th>Tình Trạng & ODO</th>
            <th>Xe Mới Đổi Sang</th>
            <th>Định Giá Dự Kiến</th>
            <th>Trạng Thái</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var t in Model)
          {
            <tr>
              <td>
                <div style="font-weight:700;color:#1a1a1a">@t.CustomerName</div>
                <div style="font-size:12px;color:#0284c7">📞 @t.PhoneNumber</div>
                @if (!string.IsNullOrEmpty(t.Email))
                {
                  <div style="font-size:11px;color:#888">✉️ @t.Email</div>
                }
              </td>
              <td>
                <strong style="color:#1a1a1a">@t.CurrentBrand @t.CurrentModel</strong>
                <div style="font-size:12px;color:#666">Năm SX: @t.ManufactureYear • @t.Transmission</div>
                @if (!string.IsNullOrEmpty(t.ImageUrl))
                {
                  <div style="margin-top:6px">
                    <a href="@t.ImageUrl" target="_blank" style="font-size:11px;color:#0284c7;text-decoration:underline">📷 Xem ảnh xe thực tế</a>
                  </div>
                }
              </td>
              <td>
                <span style="background:#f1f5f9;color:#334155;padding:3px 8px;border-radius:4px;font-size:12px;font-weight:700">
                  @t.MileageKm.ToString("N0") Km
                </span>
                @if (!string.IsNullOrEmpty(t.ConditionDescription))
                {
                  <div style="font-size:11px;color:#555;margin-top:4px">@t.ConditionDescription</div>
                }
              </td>
              <td>
                <span style="color:#e63946;font-weight:700">@(t.TargetCarModel ?? "Chỉ bán xe cũ")</span>
              </td>
              <td>
                <form method="post" action="/Admin/UpdateTradeInStatus" style="display:flex;flex-direction:column;gap:6px">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@t.Id" />
                  <div style="display:flex;gap:6px">
                    <input type="number" name="estimatedPrice" value="@(t.EstimatedPrice ?? 0)" placeholder="Nhập giá thu (VNĐ)..." 
                           style="padding:6px 8px;border:1px solid #ddd;border-radius:6px;font-size:12px;flex:1" />
                    <select name="status" onchange="this.form.submit()" style="padding:6px 10px;border-radius:6px;font-size:12px;font-weight:700;
                      background:@(t.Status == "Đã chốt thu xe" ? "#dcfce7" : (t.Status == "Đã gửi định giá" ? "#e0f2fe" : "#fef3c7"));
                      color:@(t.Status == "Đã chốt thu xe" ? "#166534" : (t.Status == "Đã gửi định giá" ? "#075985" : "#b45309"));
                      border:1px solid #ccc">
                      <option value="Chờ thẩm định" selected="@(t.Status == "Chờ thẩm định")">Chờ thẩm định</option>
                      <option value="Đã gửi định giá" selected="@(t.Status == "Đã gửi định giá")">Đã gửi định giá</option>
                      <option value="Đã chốt thu xe" selected="@(t.Status == "Đã chốt thu xe")">Đã chốt thu xe</option>
                      <option value="Hủy" selected="@(t.Status == "Hủy")">Hủy</option>
                    </select>
                  </div>
                  <input type="text" name="adminNote" value="@t.AdminNote" placeholder="Ghi chú thẩm định..." 
                         style="padding:4px 8px;border:1px solid #eee;border-radius:4px;font-size:11px" />
                </form>
              </td>
              <td>
                <span style="font-weight:700;color:@(t.Status == "Đã chốt thu xe" ? "#166534" : (t.Status == "Đã gửi định giá" ? "#0284c7" : "#b45309"))">
                  @t.Status
                </span>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
  else
  {
    <div style="text-align:center;padding:50px 20px;color:#888">
      <div>Chưa có hồ sơ định giá xe cũ nào.</div>
    </div>
  }
</div>
