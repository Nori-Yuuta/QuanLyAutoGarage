@model List<AutoGarageMVC.Models.Entities.ServiceAppointment>
@{
    Layout = "_AdminLayout";
    ViewBag.Heading = "Quản Lý Lịch Hẹn Bảo Dưỡng / Sửa Chữa";
}

<div class="admin-card">
  <div class="tab-header">
    <div>
      <h2 style="margin:0 0 4px 0">Danh Sách Đặt Lịch Bảo Dưỡng</h2>
      <small style="color:#666">Tổng cộng: @Model.Count lượt hẹn từ khách hàng</small>
    </div>
  </div>

  @if (Model != null && Model.Any())
  {
    <div style="overflow-x:auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Biển Số Xe</th>
            <th>Khách Hàng</th>
            <th>Gói Dịch Vụ</th>
            <th>Lịch Tiếp Nhận</th>
            <th>Trạng Thái</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var s in Model)
          {
            <tr>
              <td>
                <span style="background:#1a1a1a;color:#ffcc00;padding:4px 8px;border-radius:4px;font-weight:800;font-size:13px">
                  @s.LicensePlate
                </span>
                <div style="font-size:11px;color:#666;margin-top:4px">@s.CarBrandAndModel</div>
              </td>
              <td>
                <div style="font-weight:700;color:#1a1a1a">@s.CustomerName</div>
                <div style="font-size:12px;color:#0284c7">📞 @s.PhoneNumber</div>
              </td>
              <td>
                <strong style="color:#1a1a1a">@s.ServicePackage</strong>
                @if (!string.IsNullOrEmpty(s.CustomerNotes))
                {
                  <div style="font-size:11px;color:#666;font-style:italic">Ghi chú: @s.CustomerNotes</div>
                }
              </td>
              <td>
                <div>📅 @s.AppointmentDate.ToString("dd/MM/yyyy")</div>
                <div style="font-size:12px;color:#555">⏰ @s.TimeSlot</div>
              </td>
              <td>
                <form method="post" action="/Admin/UpdateServiceAppointmentStatus" style="display:inline">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@s.Id" />
                  <select name="status" onchange="this.form.submit()" style="padding:6px 10px;border-radius:6px;font-size:12px;font-weight:700;
                    background:@(s.Status == "Đã hoàn thành" ? "#dcfce7" : (s.Status == "Đang thực hiện" ? "#e0f2fe" : "#fef3c7"));
                    color:@(s.Status == "Đã hoàn thành" ? "#166534" : (s.Status == "Đang thực hiện" ? "#075985" : "#b45309"));
                    border:1px solid #ccc">
                    <option value="Chờ tiếp nhận" selected="@(s.Status == "Chờ tiếp nhận")">⏳ Chờ tiếp nhận</option>
                    <option value="Đang thực hiện" selected="@(s.Status == "Đang thực hiện")">🔧 Đang thực hiện</option>
                    <option value="Đã hoàn thành" selected="@(s.Status == "Đã hoàn thành")">✅ Đã hoàn thành</option>
                    <option value="Đã hủy" selected="@(s.Status == "Đã hủy")">❌ Đã hủy</option>
                  </select>
                </form>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
  else
  {
    <div style="text-align:center;padding:50px 20px;color:#888">
      <div>Chưa có lịch hẹn bảo dưỡng nào.</div>
    </div>
  }
</div>
