@model List<AutoGarageMVC.Models.Entities.News>
@{
    Layout = "_AdminLayout";
    ViewBag.Title = "Quản Lý Tin Tức";
    ViewBag.Heading = "Quản Lý Bản Tin & Bài Viết";
}

<div class="tab-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
  <div>
    <h2 style="margin:0 0 4px">Danh Sách Bản Tin (@Model.Count)</h2>
    <p style="margin:0;color:#666;font-size:13px">Thêm mới, cập nhật nội dung bài viết và kiểm soát tin tức hiển thị trên trang chủ.</p>
  </div>
  <button class="admin-btn primary" onclick="openNewsModal()">+ Thêm Bản Tin Mới</button>
</div>

<div class="admin-card">
  @if (!Model.Any())
  {
    <p style="text-align:center;padding:30px;color:#888;">Chưa có bản tin nào. Hãy nhấn nút "+ Thêm Bản Tin Mới" ở trên!</p>
  }
  else
  {
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Hình Ảnh</th>
          <th>Tiêu Đề</th>
          <th>Danh Mục</th>
          <th>Tác Giả</th>
          <th>Lượt Xem</th>
          <th>Ngày Đăng</th>
          <th>Hành Động</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var n in Model)
        {
          <tr>
            <td>#@n.Id</td>
            <td>
              @if (!string.IsNullOrEmpty(n.ImageUrl))
              {
                <img src="@n.ImageUrl" alt="@n.Title" style="width:60px;height:40px;object-fit:cover;border-radius:4px;border:1px solid #ddd" />
              }
              else
              {
                <div style="width:60px;height:40px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;border-radius:4px;font-size:11px;color:#888">Không ảnh</div>
              }
            </td>
            <td style="max-width:280px">
              <strong>@n.Title</strong>
              @if (!string.IsNullOrEmpty(n.Summary))
              {
                <div style="font-size:12px;color:#777;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:280px">@n.Summary</div>
              }
            </td>
            <td>
              <span style="background:#eef2ff;color:#3730a3;font-size:12px;font-weight:700;padding:3px 8px;border-radius:4px">@n.Category</span>
            </td>
            <td>@(n.Author?.Name ?? "Quản trị viên")</td>
            <td>@n.Views</td>
            <td>@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
            <td style="white-space:nowrap">
              <a href="/Home/NewsDetail/@n.Id" target="_blank" class="admin-btn outline" style="padding:6px 10px;font-size:12px;text-decoration:none;display:inline-block;margin-right:4px">Xem</a>
              <button type="button" class="admin-btn warning" style="padding:6px 10px;font-size:12px;" onclick='editNews(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                n.Id,
                n.Title,
                n.Category,
                n.Summary,
                n.Content,
                n.ImageUrl
              })))'>Sửa</button>
              <form method="post" action="/Admin/DeleteNews" style="display:inline" onsubmit="return confirm('Bạn có chắc muốn xóa bản tin này không?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@n.Id" />
                <button type="submit" class="admin-btn danger" style="padding:6px 10px;font-size:12px;">Xóa</button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  }
</div>

<!-- MODAL THÊM / SỬA BẢN TIN -->
<div id="news-modal" class="admin-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;overflow-y:auto;padding:20px;">
  <div class="admin-modal-content" style="background:#fff;padding:30px;border-radius:12px;max-width:700px;width:100%;position:relative;max-height:90vh;overflow-y:auto;">
    <button class="admin-modal-close" onclick="closeNewsModal()" style="position:absolute;top:15px;right:20px;background:none;border:none;font-size:24px;cursor:pointer;">&times;</button>
    <h2 id="modal-news-title" style="margin-top:0">Thêm Bản Tin Mới</h2>

    <form method="post" action="/Admin/SaveNews" enctype="multipart/form-data">
      @Html.AntiForgeryToken()
      <input type="hidden" id="news-id" name="Id" value="0" />

      <div class="form-group" style="margin-bottom:15px">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px">Tiêu đề bản tin *</label>
        <input type="text" id="news-title" name="Title" required style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;font-size:14px" placeholder="Nhập tiêu đề hấp dẫn..." />
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-bottom:15px">
        <div>
          <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px">Danh mục *</label>
          <select id="news-category" name="Category" style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;background:#fff">
            <option value="Xe Mới">Xe Mới</option>
            <option value="Kinh Nghiệm">Kinh Nghiệm</option>
            <option value="Công Nghệ">Công Nghệ</option>
            <option value="Bảo Dưỡng">Bảo Dưỡng</option>
            <option value="Sự Kiện">Sự Kiện</option>
          </select>
        </div>
        <div>
          <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px">URL Ảnh bài viết (hoặc tải lên bên dưới)</label>
          <input type="text" id="news-img" name="ImageUrl" style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px" placeholder="https://..." />
        </div>
      </div>

      <div class="form-group" style="margin-bottom:15px">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px">Tải ảnh đại diện từ máy tính</label>
        <input type="file" name="imageFile" accept="image/*" style="width:100%;padding:6px;border:1px solid #ddd;border-radius:6px" />
      </div>

      <div class="form-group" style="margin-bottom:15px">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px">Tóm tắt ngắn (Summary) *</label>
        <textarea id="news-summary" name="Summary" rows="2" required style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;font-family:inherit" placeholder="Tóm tắt ngắn gọn nội dung bài viết trong 1-2 câu..."></textarea>
      </div>

      <div class="form-group" style="margin-bottom:20px">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px">Nội dung chi tiết bài viết (Hỗ trợ định dạng HTML: &lt;p&gt;, &lt;h4&gt;, &lt;ul&gt;...) *</label>
        <textarea id="news-content" name="Content" rows="8" required style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;font-family:inherit;font-size:13px;line-height:1.5" placeholder="Nhập toàn bộ nội dung chi tiết bài viết tại đây..."></textarea>
      </div>

      <div style="display:flex;justify-content:flex-end;gap:10px">
        <button type="button" class="admin-btn outline" onclick="closeNewsModal()">Hủy</button>
        <button type="submit" class="admin-btn primary">Lưu Bản Tin</button>
      </div>
    </form>
  </div>
</div>

@section Scripts {
  <script>
    function openNewsModal() {
      document.getElementById('modal-news-title').textContent = 'Thêm Bản Tin Mới';
      document.getElementById('news-id').value = '0';
      document.getElementById('news-title').value = '';
      document.getElementById('news-category').value = 'Xe Mới';
      document.getElementById('news-img').value = '';
      document.getElementById('news-summary').value = '';
      document.getElementById('news-content').value = '';
      document.getElementById('news-modal').style.display = 'flex';
    }

    function editNews(news) {
      document.getElementById('modal-news-title').textContent = 'Chỉnh Sửa Bản Tin #' + news.Id;
      document.getElementById('news-id').value = news.Id;
      document.getElementById('news-title').value = news.Title || '';
      document.getElementById('news-category').value = news.Category || 'Xe Mới';
      document.getElementById('news-img').value = news.ImageUrl || '';
      document.getElementById('news-summary').value = news.Summary || '';
      document.getElementById('news-content').value = news.Content || '';
      document.getElementById('news-modal').style.display = 'flex';
    }

    function closeNewsModal() {
      document.getElementById('news-modal').style.display = 'none';
    }

    window.onclick = function(event) {
      const modal = document.getElementById('news-modal');
      if (event.target === modal) {
        closeNewsModal();
      }
    };
  </script>
}
