@{
    var type = (string)ViewBag.Type;
    var isCar = type == "car";
    ViewBag.Title = isCar ? ((Car)Model).Name : ((Accessory)Model).Name;
}

@section Styles {
  <link rel="stylesheet" href="~/css/product.css" />
}

<main class="product-wrapper">
  <a href="javascript:history.back()" class="back-link">← Quay về</a>

  @if (isCar)
  {
    var car = (Car)Model;
    var compat = (List<Accessory>)ViewBag.Compat;

    <div class="product-detail">
      <div class="product-img" style="background:#f8f9fa;display:flex;align-items:center;justify-content:center;overflow:hidden;min-height:360px;border-radius:12px;border:1px solid #eee;">
        @if (!string.IsNullOrWhiteSpace(car.ImageUrl) && (car.ImageUrl.StartsWith("/") || car.ImageUrl.StartsWith("http")))
        {
          <img src="@car.ImageUrl" alt="@car.Name" style="max-width:100%;max-height:360px;object-fit:contain;" />
        }
        else
        {
          <div style="display:flex;flex-direction:column;align-items:center;gap:12px;color:#888;">
            <svg viewBox="0 0 24 24" width="72" height="72" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 17h14M5 17l1.5-6.5A2 2 0 0 1 8.4 9h7.2a2 2 0 0 1 1.9 1.5L19 17M5 17v3M19 17v3"></path>
              <circle cx="7.5" cy="19" r="1.5"></circle>
              <circle cx="16.5" cy="19" r="1.5"></circle>
            </svg>
            <span>Chưa cập nhật ảnh xe</span>
          </div>
        }
      </div>
      <div class="product-info">
        <h1>@car.Name</h1>
        <p class="product-brand">@car.Brand</p>
        <div class="product-price">@car.Price</div>
        <p class="product-desc">@car.Description</p>
        <table class="specs-table">
          <tr><td>Năm sản xuất</td><td>@car.Year</td></tr>
          <tr><td>Động cơ</td><td>@car.Engine</td></tr>
          <tr><td>Nhiên liệu</td><td>@car.Fuel</td></tr>
          <tr><td>Số chỗ</td><td>@car.Seats</td></tr>
          <tr><td>Hộp số</td><td>@car.Transmission</td></tr>
          <tr><td>Xuất xứ</td><td>@car.Origin</td></tr>
        </table>
        
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:20px">
          <a href="/Cars/TestDrive?carId=@car.Id" class="btn-buy-now" style="background:#e63946;color:#fff;text-align:center;text-decoration:none;display:flex;align-items:center;justify-content:center;gap:8px">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 17h14M5 17l1.5-6.5A2 2 0 0 1 8.4 9h7.2a2 2 0 0 1 1.9 1.5L19 17M5 17v3M19 17v3"></path>
              <circle cx="7.5" cy="19" r="1.5"></circle>
              <circle cx="16.5" cy="19" r="1.5"></circle>
            </svg>
            <span>Đăng Ký Lái Thử Xe Này</span>
          </a>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
            <a href="/Cars/Calculator?carId=@car.Id" style="padding:12px;background:#1a1a1a;color:#ffcc00;border:1px solid #ffcc00;border-radius:8px;font-weight:700;text-align:center;text-decoration:none;font-size:13px">
              Tính Trả Góp & Lăn Bánh
            </a>
            <a href="/Cars/Compare?car1=@car.Id" style="padding:12px;background:#f4f6f8;color:#333;border:1px solid #ddd;border-radius:8px;font-weight:700;text-align:center;text-decoration:none;font-size:13px">
              So Sánh Xe Khác
            </a>
          </div>
        </div>
      </div>
    </div>

    @if (compat != null && compat.Any())
    {
      <section class="compat-section" style="margin-top:40px">
        <h2 class="section-title">Phụ Kiện Tương Thích Cho Xe @car.Brand</h2>
        <div class="grid">
          @foreach (var acc in compat)
          {
            <a class="card" href="/Product/Detail?type=acc&id=@acc.Id">
              <div class="card-img" style="background:#f8f9fa;display:flex;align-items:center;justify-content:center;overflow:hidden;height:180px;">
                @if (!string.IsNullOrWhiteSpace(acc.ImageUrl) && (acc.ImageUrl.StartsWith("/") || acc.ImageUrl.StartsWith("http")))
                {
                  <img src="@acc.ImageUrl" alt="@acc.Name" style="width:100%;height:100%;object-fit:cover;" />
                }
                else
                {
                  <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#888" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                  </svg>
                }
              </div>
              <div class="card-body">
                <div class="card-brand">@acc.Category</div>
                <div class="card-title">@acc.Name</div>
                <div class="card-price">@acc.Price</div>
              </div>
            </a>
          }
        </div>
      </section>
    }
  }
  else
  {
    var acc = (Accessory)Model;
    <div class="product-detail">
      <div class="product-img" style="background:#f8f9fa;display:flex;align-items:center;justify-content:center;overflow:hidden;min-height:360px;border-radius:12px;border:1px solid #eee;">
        @if (!string.IsNullOrWhiteSpace(acc.ImageUrl) && (acc.ImageUrl.StartsWith("/") || acc.ImageUrl.StartsWith("http")))
        {
          <img src="@acc.ImageUrl" alt="@acc.Name" style="max-width:100%;max-height:360px;object-fit:contain;" />
        }
        else
        {
          <div style="display:flex;flex-direction:column;align-items:center;gap:12px;color:#888;">
            <svg viewBox="0 0 24 24" width="72" height="72" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
            <span>Chưa cập nhật ảnh phụ kiện</span>
          </div>
        }
      </div>
      <div class="product-info">
        <h1>@acc.Name</h1>
        <p class="product-brand">@acc.Category</p>
        <div class="product-price">@acc.Price</div>
        <p class="product-desc">@acc.Description</p>
        <table class="specs-table">
          <tr><td>Chất liệu</td><td>@(acc.Material ?? "Tiêu chuẩn")</td></tr>
          <tr><td>Bảo hành</td><td>@(acc.Warranty ?? "Chính hãng")</td></tr>
          <tr><td>Tương thích</td><td>@(acc.Compat ?? "Mọi dòng xe")</td></tr>
        </table>

        <form method="post" action="/Cart/Add" class="purchase-form">
          @Html.AntiForgeryToken()
          <input type="hidden" name="id" value="@acc.Id" />
          <div class="purchase-row">
            <div class="qty-control">
              <button type="button" class="qty-btn" onclick="let q=document.getElementById('p-qty');q.value=Math.max(1,parseInt(q.value)-1)">−</button>
              <input type="number" name="qty" id="p-qty" class="qty-input" value="1" min="1" max="99" />
              <button type="button" class="qty-btn" onclick="let q=document.getElementById('p-qty');q.value=parseInt(q.value)+1">+</button>
            </div>
            <button type="submit" class="btn-add-cart">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:6px">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.6 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path>
              </svg>
              Thêm vào giỏ
            </button>
          </div>
        </form>
      </div>
    </div>
  }
</main>
