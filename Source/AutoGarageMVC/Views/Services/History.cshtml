@model List<AutoGarageMVC.Models.Entities.ServiceHistoryRecord>
@{
    ViewBag.Title = "Tra Cứu Lịch Sử Bảo Hành & Bảo Dưỡng";
    string query = ViewBag.Query as string ?? "";
}

@section Styles {
  <link rel="stylesheet" href="~/css/page.css" />
  <style>
    .his-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 30px 20px 60px;
    }
    .his-hero-card {
      background: #1a1a1a;
      color: #fff;
      padding: 30px;
      border-radius: 14px;
      margin-bottom: 30px;
      border-left: 6px solid #ffcc00;
    }
    .his-search-card {
      background: #fff;
      padding: 24px;
      border-radius: 14px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.06);
      margin-bottom: 30px;
    }
    .his-search-box {
      display: flex;
      gap: 10px;
    }
    .his-search-box input {
      flex: 1;
      padding: 14px 18px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 15px;
      outline: none;
      font-family: inherit;
    }
    .his-search-box input:focus {
      border-color: #ffcc00;
    }
    .his-search-btn {
      padding: 14px 28px;
      background: #ffcc00;
      color: #1a1a1a;
      border: none;
      border-radius: 8px;
      font-weight: 800;
      font-size: 15px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
    }
    .his-search-btn:hover {
      background: #ffaa00;
    }
    .his-record-card {
      background: #fff;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 20px;
      box-shadow: 0 3px 15px rgba(0,0,0,0.05);
      border-left: 4px solid #1a1a1a;
      transition: transform 0.2s;
    }
    .his-record-card:hover {
      transform: translateY(-2px);
    }
    .his-record-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 14px;
      border-bottom: 1px solid #eee;
      margin-bottom: 14px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .his-badge-plate {
      background: #1a1a1a;
      color: #ffcc00;
      padding: 6px 12px;
      border-radius: 6px;
      font-weight: 800;
      font-size: 14px;
      letter-spacing: 1px;
    }
    .his-grid-details {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      font-size: 14px;
    }
    .his-detail-item strong {
      display: block;
      color: #888;
      font-size: 12px;
      margin-bottom: 3px;
    }
    @@media (max-width: 768px) {
      .his-search-box { flex-direction: column; }
      .his-grid-details { grid-template-columns: 1fr; }
    }
  </style>
}

<div class="his-container">
  <div class="his-hero-card">
    <span style="background:#ffcc00;color:#1a1a1a;padding:4px 10px;border-radius:4px;font-size:12px;font-weight:800;letter-spacing:1px">MINH BẠCH & BẢO HÀNH</span>
    <h1 style="margin:12px 0 6px 0;font-size:28px">Tra Cứu Lịch Sử Bảo Dưỡng Xe</h1>
    <p style="margin:0;color:#bbb;font-size:14px">Nhập biển số xe hoặc mã số khung (VIN) để tra cứu lịch sử thay dầu, sửa chữa phụ tùng và mốc hẹn bảo dưỡng tiếp theo tại AutoGarage.</p>
  </div>

  <div class="his-search-card">
    <form method="get" action="/Services/History">
      <div class="his-search-box">
        <input type="text" name="query" value="@query" placeholder="Nhập Biển số xe (ví dụ: 51H-888.88) hoặc Mã khung VIN (ví dụ: VNTOYOTA202401)..." required />
        <button type="submit" class="his-search-btn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>TRA CỨU NGAY</span>
        </button>
      </div>
      <div style="margin-top:10px;font-size:12px;color:#888">
        Gợi ý test nhanh: thử tìm biển số <strong>51H-888.88</strong> hoặc <strong>30G-678.99</strong>
      </div>
    </form>
  </div>

  @if (!string.IsNullOrWhiteSpace(query))
  {
    if (Model != null && Model.Any())
    {
      <h3 style="margin-bottom:20px;color:#1a1a1a">
        Tìm thấy <strong>@Model.Count</strong> lượt dịch vụ của phương tiện: <span style="color:#0284c7">@query</span>
      </h3>

      @foreach (var r in Model)
      {
        <div class="his-record-card">
          <div class="his-record-header">
            <div>
              <span class="his-badge-plate">@r.LicensePlate</span>
              <strong style="margin-left:10px;font-size:16px;color:#1a1a1a">@r.CarModel</strong>
              @if (!string.IsNullOrEmpty(r.VinNumber))
              {
                <span style="font-size:12px;color:#666;margin-left:8px">(VIN: @r.VinNumber)</span>
              }
            </div>
            <div style="font-weight:700;color:#0284c7">
              Ngày làm: @r.ServiceDate.ToString("dd/MM/yyyy")
            </div>
          </div>

          <div class="his-grid-details">
            <div class="his-detail-item">
              <strong>Số ODO ghi nhận</strong>
              <span>@r.MileageKm.ToString("N0") Km</span>
            </div>
            <div class="his-detail-item">
              <strong>Kỹ thuật viên phụ trách</strong>
              <span>@r.TechnicianName</span>
            </div>
            <div class="his-detail-item">
              <strong>Tổng chi phí dịch vụ</strong>
              <span style="font-weight:700;color:#e63946">@r.TotalCost.ToString("N0") ₫</span>
            </div>
          </div>

          <div style="margin-top:14px;padding-top:12px;border-top:1px dashed #eee;font-size:14px">
            <div style="margin-bottom:6px">
              <strong>Hạng mục đã thực hiện:</strong> @r.ServicePerformed
            </div>
            @if (!string.IsNullOrEmpty(r.PartsReplaced))
            {
              <div style="margin-bottom:6px;color:#555">
                <strong>Phụ tùng thay thế:</strong> @r.PartsReplaced
              </div>
            }
            @if (!string.IsNullOrEmpty(r.NextServiceRecommendation))
            {
              <div style="color:#166534;background:#f0fdf4;padding:8px 12px;border-radius:6px;display:inline-block;margin-top:6px;font-size:13px;border:1px solid #bbf7d0">
                <strong>Khuyến nghị đợt tới:</strong> @r.NextServiceRecommendation
              </div>
            }
          </div>
        </div>
      }
    }
    else
    {
      <div style="background:#fff;padding:50px 20px;text-align:center;border-radius:12px;box-shadow:0 3px 15px rgba(0,0,0,0.05)">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="#999" stroke-width="1.5" style="margin-bottom:12px">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <h3 style="margin:0 0 6px 0;color:#333">Không tìm thấy dữ liệu dịch vụ</h3>
        <p style="margin:0;color:#777;font-size:14px">Chưa có bản ghi nào trùng khớp với từ khóa "@query". Vui lòng kiểm tra lại biển số hoặc mã VIN.</p>
      </div>
    }
  }
</div>
