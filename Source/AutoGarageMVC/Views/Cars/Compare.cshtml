@model List<AutoGarageMVC.Models.Entities.Car>
@{
    ViewBag.Title = "So Sánh Xe Ô Tô";
    var allCars = (List<AutoGarageMVC.Models.Entities.Car>)ViewBag.AllCars;
    int car1Id = ViewBag.Car1 ?? 0;
    int car2Id = ViewBag.Car2 ?? 0;
    int car3Id = ViewBag.Car3 ?? 0;
}

@section Styles {
  <link rel="stylesheet" href="~/css/page.css" />
  <style>
    .compare-container {
      max-width: 1300px;
      margin: 0 auto;
      padding: 30px 20px 60px;
    }
    .compare-header-card {
      background: #1a1a1a;
      color: #fff;
      padding: 30px;
      border-radius: 14px;
      margin-bottom: 30px;
      border-left: 6px solid #ffcc00;
    }
    .compare-selectors {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 30px;
      background: #fff;
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }
    .compare-select-col {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .compare-select-col label {
      font-weight: 700;
      font-size: 14px;
      color: #333;
    }
    .compare-select-col select {
      padding: 12px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 14px;
      background: #fdfdfd;
      outline: none;
      cursor: pointer;
    }
    .compare-select-col select:focus {
      border-color: #ffcc00;
    }
    .compare-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }
    .compare-table th, .compare-table td {
      padding: 16px 20px;
      text-align: center;
      border-bottom: 1px solid #eee;
    }
    .compare-table th.feature-title, .compare-table td.feature-title {
      text-align: left;
      font-weight: 700;
      color: #1a1a1a;
      background: #f8f9fa;
      width: 25%;
      border-right: 1px solid #eee;
    }
    .compare-table td.car-col {
      width: 25%;
      vertical-align: top;
    }
    .compare-car-thumb {
      height: 160px;
      background: #f8f9fa;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      margin-bottom: 12px;
      border: 1px solid #eee;
    }
    .compare-car-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .compare-car-name {
      font-size: 18px;
      font-weight: 800;
      color: #1a1a1a;
      margin-bottom: 6px;
    }
    .compare-car-price {
      font-size: 16px;
      font-weight: 700;
      color: #e63946;
      margin-bottom: 12px;
    }
    .compare-action-btn {
      display: inline-block;
      padding: 8px 16px;
      background: #ffcc00;
      color: #1a1a1a;
      font-weight: 700;
      border-radius: 6px;
      text-decoration: none;
      font-size: 13px;
      transition: all 0.2s;
    }
    .compare-action-btn:hover {
      background: #ffaa00;
      transform: translateY(-1px);
    }
    .spec-highlight {
      font-weight: 700;
      color: #1a1a1a;
    }
    @@media (max-width: 900px) {
      .compare-selectors { grid-template-columns: 1fr; }
      .compare-table { display: block; overflow-x: auto; }
    }
  </style>
}

<div class="compare-container">
  <div class="compare-header-card">
    <span style="background:#ffcc00;color:#1a1a1a;padding:4px 10px;border-radius:4px;font-size:12px;font-weight:800;letter-spacing:1px">CÔNG CỤ ĐÁNH GIÁ</span>
    <h1 style="margin:12px 0 6px 0;font-size:28px">So Sánh Thông Số Xe Ô Tô</h1>
    <p style="margin:0;color:#bbb;font-size:14px">Đặt cạnh nhau tối đa 3 mẫu xe để đối chiếu giá bán, động cơ, kích thước, nhiên liệu và tiện nghi.</p>
  </div>

  <!-- BỘ CHỌN XE -->
  <form method="get" action="/Cars/Compare" class="compare-selectors" id="compare-form">
    <div class="compare-select-col">
      <label>Mẫu xe 1 (Gốc)</label>
      <select name="car1" onchange="document.getElementById('compare-form').submit()">
        <option value="">-- Chọn xe 1 --</option>
        @foreach (var c in allCars)
        {
          <option value="@c.Id" selected="@(car1Id == c.Id)">@c.Name (@c.Brand) - @c.Price</option>
        }
      </select>
    </div>

    <div class="compare-select-col">
      <label>Mẫu xe 2</label>
      <select name="car2" onchange="document.getElementById('compare-form').submit()">
        <option value="">-- Chọn xe 2 --</option>
        @foreach (var c in allCars)
        {
          <option value="@c.Id" selected="@(car2Id == c.Id)">@c.Name (@c.Brand) - @c.Price</option>
        }
      </select>
    </div>

    <div class="compare-select-col">
      <label>Mẫu xe 3 (Tùy chọn)</label>
      <select name="car3" onchange="document.getElementById('compare-form').submit()">
        <option value="">-- Chọn xe 3 (Không bắt buộc) --</option>
        @foreach (var c in allCars)
        {
          <option value="@c.Id" selected="@(car3Id == c.Id)">@c.Name (@c.Brand) - @c.Price</option>
        }
      </select>
    </div>
  </form>

  <!-- BẢNG SO SÁNH -->
  @if (Model != null && Model.Any())
  {
    <table class="compare-table">
      <!-- 1. HÌNH ẢNH & THÔNG TIN CƠ BẢN -->
      <tr>
        <th class="feature-title">Hình ảnh & Tên xe</th>
        @foreach (var car in Model)
        {
          <td class="car-col">
            <div class="compare-car-thumb">
              @if (!string.IsNullOrWhiteSpace(car.ImageUrl) && (car.ImageUrl.StartsWith("/") || car.ImageUrl.StartsWith("http")))
              {
                <img src="@car.ImageUrl" alt="@car.Name" />
              }
              else
              {
                <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="#888" stroke-width="1.5">
                  <path d="M5 17h14M5 17l1.5-6.5A2 2 0 0 1 8.4 9h7.2a2 2 0 0 1 1.9 1.5L19 17M5 17v3M19 17v3"></path>
                  <circle cx="7.5" cy="19" r="1.5"></circle>
                  <circle cx="16.5" cy="19" r="1.5"></circle>
                </svg>
              }
            </div>
            <div class="compare-car-name">@car.Name</div>
            <div class="compare-car-price">@car.Price</div>
            <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap">
              <a href="/Product/Detail?type=car&id=@car.Id" class="compare-action-btn">Chi tiết</a>
              <a href="/Cars/TestDrive?carId=@car.Id" class="compare-action-btn" style="background:#1a1a1a;color:#fff">Lái thử</a>
            </div>
          </td>
        }
      </tr>

      <!-- 2. THƯƠNG HIỆU -->
      <tr>
        <td class="feature-title">Hãng sản xuất</td>
        @foreach (var car in Model)
        {
          <td class="spec-highlight">@car.Brand</td>
        }
      </tr>

      <!-- 3. NĂM SẢN XUẤT -->
      <tr>
        <td class="feature-title">Năm sản xuất / Đời xe</td>
        @foreach (var car in Model)
        {
          <td>@car.Year</td>
        }
      </tr>

      <!-- 4. ĐỘNG CƠ -->
      <tr>
        <td class="feature-title">Động cơ</td>
        @foreach (var car in Model)
        {
          <td class="spec-highlight">@(string.IsNullOrWhiteSpace(car.Engine) ? "Đang cập nhật" : car.Engine)</td>
        }
      </tr>

      <!-- 5. NHIÊN LIỆU -->
      <tr>
        <td class="feature-title">Nhiên liệu</td>
        @foreach (var car in Model)
        {
          <td>@(string.IsNullOrWhiteSpace(car.Fuel) ? "Xăng" : car.Fuel)</td>
        }
      </tr>

      <!-- 6. HỘP SỐ -->
      <tr>
        <td class="feature-title">Hộp số</td>
        @foreach (var car in Model)
        {
          <td>@(string.IsNullOrWhiteSpace(car.Transmission) ? "Tự động" : car.Transmission)</td>
        }
      </tr>

      <!-- 7. SỐ CHỖ NGỒI -->
      <tr>
        <td class="feature-title">Số chỗ ngồi</td>
        @foreach (var car in Model)
        {
          <td class="spec-highlight">@(car.Seats.HasValue ? $"{car.Seats} chỗ" : "5 chỗ")</td>
        }
      </tr>

      <!-- 8. XUẤT XỨ -->
      <tr>
        <td class="feature-title">Xuất xứ</td>
        @foreach (var car in Model)
        {
          <td>@(string.IsNullOrWhiteSpace(car.Origin) ? "Nhập khẩu / Lắp ráp" : car.Origin)</td>
        }
      </tr>

      <!-- 9. MÔ TẢ ĐẶC TÍNH -->
      <tr>
        <td class="feature-title">Đặc tính nổi bật</td>
        @foreach (var car in Model)
        {
          <td style="font-size:13px;color:#555;line-height:1.6">@car.Description</td>
        }
      </tr>

      <!-- 10. TÍNH DỰ TOÁN TRẢ GÓP & LĂN BÁNH -->
      <tr>
        <td class="feature-title">Dự toán ngân sách</td>
        @foreach (var car in Model)
        {
          <td>
            <a href="/Cars/Calculator?carId=@car.Id" style="color:#0284c7;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:4px">
              <span>Tính trả góp & lăn bánh</span> →
            </a>
          </td>
        }
      </tr>
    </table>
  }
  else
  {
    <div style="background:#fff;padding:40px;text-align:center;border-radius:12px">
      <h3>Vui lòng chọn ít nhất 2 mẫu xe từ danh sách ở trên để tiến hành so sánh.</h3>
    </div>
  }
</div>
