@{
    var action = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
    var adminName = User.FindFirst("DisplayName")?.Value ?? "Admin";
    var adminEmail = User.Identity?.Name ?? "admin@autogarage.vn";
    var initial = !string.IsNullOrEmpty(adminName) ? adminName.Substring(0, 1).ToUpper() : "A";
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewBag.Title — Quản Trị Viên AutoGarage</title>
  <link rel="stylesheet" href="~/css/style.css" />
  <link rel="stylesheet" href="~/css/toast.css" />
  <link rel="stylesheet" href="~/css/admin.css" />
  @RenderSection("Styles", false)
</head>
<body class="admin-body">
  <!-- SIDEBAR -->
  <aside class="admin-sidebar">
    <div class="admin-logo">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 17h14M5 17l1.5-6.5A2 2 0 0 1 8.4 9h7.2a2 2 0 0 1 1.9 1.5L19 17M5 17v3M19 17v3"></path>
        <circle cx="7.5" cy="19" r="1.5"></circle>
        <circle cx="16.5" cy="19" r="1.5"></circle>
      </svg>
      AutoGarage Admin
    </div>

    <nav class="admin-nav">
      <a href="/Admin/Dashboard" class="admin-nav-item @(action == "dashboard" ? "active" : "")">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:8px"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>Thống Kê Doanh Thu
      </a>
      <a href="/Admin/Cars" class="admin-nav-item @(action == "cars" ? "active" : "")">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:8px"><path d="M5 17h14M5 17l1.5-6.5A2 2 0 0 1 8.4 9h7.2a2 2 0 0 1 1.9 1.5L19 17M5 17v3M19 17v3"></path><circle cx="7.5" cy="19" r="1.5"></circle><circle cx="16.5" cy="19" r="1.5"></circle></svg>Quản Lý Xe
      </a>
      <a href="/Admin/Accessories" class="admin-nav-item @(action == "accessories" ? "active" : "")">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:8px"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>Quản Lý Phụ Kiện
      </a>
      <a href="/Admin/Notifications" class="admin-nav-item @(action == "notifications" ? "active" : "")">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:8px"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>Quản Lý Thông Báo
      </a>
      <a href="/Admin/Events" class="admin-nav-item @(action == "events" ? "active" : "")">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:8px"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>Quản Lý Sự Kiện
      </a>
      <a href="/Admin/Chat" class="admin-nav-item @(action == "chat" ? "active" : "")">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:8px"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>Chat Hỗ Trợ
      </a>
      <a href="/Admin/Account" class="admin-nav-item @(action == "account" ? "active" : "")">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:8px"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>Thông Tin Tài Khoản
      </a>
    </nav>

    <div class="admin-sidebar-bottom">
      <form method="post" action="/Auth/Logout">
        @Html.AntiForgeryToken()
        <button type="submit" class="admin-btn danger" style="width:100%">Đăng Xuất</button>
      </form>
      <a href="/" class="admin-btn outline" style="text-align:center;text-decoration:none">Về Trang Chủ</a>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="admin-main">
    <header class="admin-header">
      <h1 id="page-heading">@ViewBag.Heading</h1>
      <a href="/Admin/Account" class="admin-profile" style="text-decoration:none">
        <div class="admin-profile-info">
          <div class="admin-name">@adminName</div>
          <div class="admin-email">@adminEmail</div>
        </div>
        <div class="avatar">@initial</div>
      </a>
    </header>

    <div class="admin-content">
      @RenderBody()
    </div>
  </main>

  <partial name="_Toast" />
  <script src="~/js/toast.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.__toast && window.Toast) {
        const t = window.__toast;
        (Toast[t.type] || Toast.info)(t.title, t.msg);
      }
    });
  </script>
  @RenderSection("Scripts", false)
</body>
</html>
