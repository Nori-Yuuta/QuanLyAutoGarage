@model AutoGarageMVC.Models.ViewModels.LoginVM
@{
    Layout = null;
    var returnUrl = (string?)ViewBag.ReturnUrl;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đăng Nhập — AutoGarage</title>
  <link rel="stylesheet" href="~/css/style.css" />
  <link rel="stylesheet" href="~/css/auth.css" />
  <link rel="stylesheet" href="~/css/toast.css" />
</head>
<body class="auth-page">

<div class="auth-container">
  <div class="auth-tabs">
    <a href="/Auth/Login" class="auth-tab active">Đăng Nhập</a>
    <a href="/Auth/Register" class="auth-tab">Đăng Ký</a>
  </div>

  <form method="post" action="/Auth/Login@(string.IsNullOrEmpty(returnUrl) ? "" : $"?returnUrl={returnUrl}")" class="auth-form">
    @Html.AntiForgeryToken()
    <h2 class="auth-title">Chào mừng trở lại</h2>
    <p class="auth-desc">Đăng nhập để tiếp tục với AutoGarage.</p>

    <div asp-validation-summary="ModelOnly" style="color:#e63946;margin-bottom:15px;font-size:13px;font-weight:600"></div>

    <div class="form-group">
      <label>Email</label>
      <input asp-for="Email" type="email" placeholder="ban@example.com" required autofocus />
      <span asp-validation-for="Email" style="color:#e63946;font-size:12px"></span>
    </div>

    <div class="form-group">
      <label>Mật khẩu</label>
      <input asp-for="Password" type="password" placeholder="••••••••" required minlength="6" />
      <span asp-validation-for="Password" style="color:#e63946;font-size:12px"></span>
    </div>

    <div class="form-group" style="display:flex;align-items:center;gap:8px;margin-bottom:15px">
      <input asp-for="RememberMe" type="checkbox" id="rememberMe" style="width:auto;cursor:pointer" />
      <label for="rememberMe" style="margin:0;font-size:14px;cursor:pointer">Ghi nhớ đăng nhập</label>
    </div>

    <button type="submit" class="auth-submit">Đăng Nhập</button>
    <p class="auth-switch">
      Chưa có tài khoản?
      <a href="/Auth/Register">Đăng ký ngay</a>
    </p>
    <a href="/" class="auth-back">← Quay về trang chủ</a>
  </form>
</div>

<partial name="_Toast" />
<script src="~/js/toast.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.__toast && window.Toast) {
      const t = window.__toast;
      (Toast[t.type] || Toast.info)(t.title, t.msg);
    }
  });
</script>
</body>
</html>
