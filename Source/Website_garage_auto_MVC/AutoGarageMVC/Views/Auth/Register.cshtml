@model AutoGarageMVC.Models.ViewModels.RegisterVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đăng Ký Tài Khoản — AutoGarage</title>
  <link rel="stylesheet" href="~/css/style.css" />
  <link rel="stylesheet" href="~/css/auth.css" />
  <link rel="stylesheet" href="~/css/toast.css" />
</head>
<body class="auth-page">

<div class="auth-container">
  <div class="auth-tabs">
    <a href="/Auth/Login" class="auth-tab">Đăng Nhập</a>
    <a href="/Auth/Register" class="auth-tab active">Đăng Ký</a>
  </div>

  <form method="post" action="/Auth/Register" class="auth-form">
    @Html.AntiForgeryToken()
    <h2 class="auth-title">Tạo tài khoản mới</h2>
    <p class="auth-desc">Chỉ mất vài giây để bắt đầu trải nghiệm tại AutoGarage.</p>

    <div asp-validation-summary="ModelOnly" style="color:#e63946;margin-bottom:15px;font-size:13px;font-weight:600"></div>

    <div class="form-group">
      <label>Họ và tên</label>
      <input asp-for="Name" type="text" placeholder="Nguyễn Văn A" required autofocus />
      <span asp-validation-for="Name" style="color:#e63946;font-size:12px"></span>
    </div>

    <div class="form-group">
      <label>Email</label>
      <input asp-for="Email" type="email" placeholder="ban@example.com" required />
      <span asp-validation-for="Email" style="color:#e63946;font-size:12px"></span>
    </div>

    <div class="form-group">
      <label>Số điện thoại</label>
      <input asp-for="Phone" type="tel" placeholder="0901 234 567" required />
      <span asp-validation-for="Phone" style="color:#e63946;font-size:12px"></span>
    </div>

    <div class="form-group">
      <label>Mật khẩu</label>
      <input asp-for="Password" type="password" placeholder="Tối thiểu 6 ký tự" required minlength="6" />
      <span asp-validation-for="Password" style="color:#e63946;font-size:12px"></span>
    </div>

    <div class="form-group">
      <label>Xác nhận mật khẩu</label>
      <input asp-for="ConfirmPassword" type="password" placeholder="Nhập lại mật khẩu" required minlength="6" />
      <span asp-validation-for="ConfirmPassword" style="color:#e63946;font-size:12px"></span>
    </div>

    <button type="submit" class="auth-submit">Đăng Ký</button>
    <p class="auth-switch">
      Đã có tài khoản?
      <a href="/Auth/Login">Đăng nhập ngay</a>
    </p>
    <a href="/" class="auth-back">← Quay về trang chủ</a>
  </form>
</div>

<partial name="_Toast" />
<script src="~/js/toast.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.__toast && window.Toast) {
      const t = window.__toast;
      (Toast[t.type] || Toast.info)(t.title, t.msg);
    }
  });
</script>
</body>
</html>
