@{
    var type = (string)ViewBag.Type;
    var isCar = type == "car";
    ViewBag.Title = isCar ? ((Car)Model).Name : ((Accessory)Model).Name;
}

@section Styles {
  <link rel="stylesheet" href="~/css/product.css" />
}

<main class="product-wrapper">
  <a href="javascript:history.back()" class="back-link">← Quay về</a>

  @if (isCar)
  {
    var car = (Car)Model;
    var compat = (List<Accessory>)ViewBag.Compat;

    <div class="product-detail">
      <div class="product-img" style="background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;">
        @if (car.ImageUrl != null && car.ImageUrl.StartsWith("/uploads"))
        {
          <img src="@car.ImageUrl" style="max-width:100%;max-height:100%;object-fit:contain;" />
        }
        else
        {
          <span style="font-size:140px">@car.ImageUrl</span>
        }
      </div>
      <div class="product-info">
        <h1>@car.Name</h1>
        <p class="product-brand">@car.Brand</p>
        <div class="product-price">@car.Price</div>
        <p class="product-desc">@car.Description</p>
        <table class="specs-table">
          <tr><td>Năm sản xuất</td><td>@car.Year</td></tr>
          <tr><td>Động cơ</td><td>@car.Engine</td></tr>
          <tr><td>Nhiên liệu</td><td>@car.Fuel</td></tr>
          <tr><td>Số chỗ</td><td>@car.Seats</td></tr>
          <tr><td>Hộp số</td><td>@car.Transmission</td></tr>
          <tr><td>Xuất xứ</td><td>@car.Origin</td></tr>
        </table>
        <button class="btn-buy-now" id="contact-car-btn" type="button" onclick="alert('Vui lòng gọi hotline tư vấn mua xe: 0901 234 567')">
          Liên hệ đặt mua xe
        </button>
      </div>
    </div>

    @if (compat != null && compat.Any())
    {
      <section class="compat-section" style="margin-top:40px">
        <h2 class="section-title">Phụ Kiện Tương Thích Cho Xe @car.Brand</h2>
        <div class="grid">
          @foreach (var acc in compat)
          {
            <a class="card" href="/Product/Detail?type=acc&id=@acc.Id">
              <div class="card-img" style="background:#fff;display:flex;align-items:center;justify-content:center;">
                @if (acc.ImageUrl != null && acc.ImageUrl.StartsWith("/uploads"))
                {
                  <img src="@acc.ImageUrl" style="width:100%;height:100%;object-fit:cover;" />
                }
                else
                {
                  <span style="font-size:60px">@acc.ImageUrl</span>
                }
              </div>
              <div class="card-body">
                <div class="card-brand">@acc.Category</div>
                <div class="card-title">@acc.Name</div>
                <div class="card-price">@acc.Price</div>
              </div>
            </a>
          }
        </div>
      </section>
    }
  }
  else
  {
    var acc = (Accessory)Model;
    <div class="product-detail">
      <div class="product-img" style="background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;">
        @if (acc.ImageUrl != null && acc.ImageUrl.StartsWith("/uploads"))
        {
          <img src="@acc.ImageUrl" style="max-width:100%;max-height:100%;object-fit:contain;" />
        }
        else
        {
          <span style="font-size:140px">@acc.ImageUrl</span>
        }
      </div>
      <div class="product-info">
        <h1>@acc.Name</h1>
        <p class="product-brand">@acc.Category</p>
        <div class="product-price">@acc.Price</div>
        <p class="product-desc">@acc.Description</p>
        <table class="specs-table">
          <tr><td>Chất liệu</td><td>@(acc.Material ?? "Tiêu chuẩn")</td></tr>
          <tr><td>Bảo hành</td><td>@(acc.Warranty ?? "Chính hãng")</td></tr>
          <tr><td>Tương thích</td><td>@(acc.Compat ?? "Mọi dòng xe")</td></tr>
        </table>

        <form method="post" action="/Product/AddToCart">
          @Html.AntiForgeryToken()
          <input type="hidden" name="id" value="@acc.Id" />
          <div class="purchase-row">
            <div class="qty-control">
              <button type="button" class="qty-btn" onclick="let q=document.getElementById('p-qty');q.value=Math.max(1,parseInt(q.value)-1)">−</button>
              <input type="number" name="qty" id="p-qty" class="qty-input" value="1" min="1" max="99" />
              <button type="button" class="qty-btn" onclick="let q=document.getElementById('p-qty');q.value=parseInt(q.value)+1">+</button>
            </div>
            <button type="submit" class="btn-add-cart">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:6px">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.6 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path>
              </svg>
              Thêm vào giỏ
            </button>
          </div>
        </form>
      </div>
    </div>
  }
</main>
