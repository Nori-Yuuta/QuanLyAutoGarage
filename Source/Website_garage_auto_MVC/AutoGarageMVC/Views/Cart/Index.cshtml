@model List<AutoGarageMVC.Services.CartItem>
@{
    ViewBag.Title = "Giỏ Hàng";
    var subtotal = (decimal)ViewBag.Subtotal;
    var shipping = (decimal)ViewBag.Shipping;
    var total = (decimal)ViewBag.Total;
}

@section Styles {
  <link rel="stylesheet" href="~/css/cart.css" />
}

<main class="cart-wrapper">
  <a href="/Accessories" class="back-link">← Tiếp tục mua sắm phụ kiện</a>
  <h1 class="cart-title">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:8px">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.6 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path>
    </svg>
    Giỏ Hàng Của Bạn
    @if (Model.Any())
    {
      <span style="font-size:16px;background:#ffcc00;color:#1a1a1a;padding:4px 12px;border-radius:20px;font-weight:700">@Model.Sum(x => x.Qty) sản phẩm</span>
    }
  </h1>

  @if (!Model.Any())
  {
    <div class="cart-empty">
      <div class="cart-empty-icon">
        <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.6 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path>
        </svg>
      </div>
      <h2 style="font-size:22px;margin-bottom:8px">Giỏ hàng của bạn đang trống</h2>
      <p>Hãy lựa chọn những món phụ kiện chính hãng ưng ý nhất cho xế yêu của bạn!</p>
      <a href="/Accessories" class="btn-primary">
        <span>Khám phá phụ kiện ngay</span>
        <span>→</span>
      </a>
    </div>
  }
  else
  {
    <div class="cart-layout">
      <div class="cart-items">
        @foreach (var item in Model)
        {
          <div class="cart-item">
            <div class="cart-item-img">
              @if (item.ImageUrl != null && item.ImageUrl.StartsWith("/uploads"))
              {
                <img src="@item.ImageUrl" alt="@item.Name" />
              }
              else
              {
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                </svg>
              }
            </div>

            <div class="cart-item-info">
              <h4>@item.Name</h4>
              <small>@item.Category</small>
              <div style="font-size:13px;color:#777;margin-top:4px">Đơn giá: @item.Price.ToString("N0") ₫</div>
            </div>

            <div class="qty-control">
              <form method="post" action="/Cart/UpdateQty" style="display:inline;margin:0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id" />
                <input type="hidden" name="delta" value="-1" />
                <button type="submit" class="qty-btn" title="Giảm số lượng">−</button>
              </form>

              <span class="qty-input">@item.Qty</span>

              <form method="post" action="/Cart/UpdateQty" style="display:inline;margin:0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id" />
                <input type="hidden" name="delta" value="1" />
                <button type="submit" class="qty-btn" title="Tăng số lượng">+</button>
              </form>
            </div>

            <div class="cart-item-price">
              @((item.Price * item.Qty).ToString("N0")) ₫
            </div>

            <form method="post" action="/Cart/Remove" style="margin:0" onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ?')">
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@item.Id" />
              <button type="submit" class="cart-item-remove" title="Xóa món này">×</button>
            </form>
          </div>
        }
      </div>

      <aside class="cart-summary">
        <h3>Tóm Tắt Đơn Hàng</h3>

        <div class="summary-row">
          <span>Tạm tính (@Model.Sum(x => x.Qty) món):</span>
          <strong>@subtotal.ToString("N0") ₫</strong>
        </div>

        <div class="summary-row">
          <span>Phí vận chuyển:</span>
          <strong>@(shipping == 0 ? "Miễn phí" : shipping.ToString("N0") + " ₫")</strong>
        </div>

        <div class="summary-row total">
          <span>Tổng thanh toán:</span>
          <span>@total.ToString("N0") ₫</span>
        </div>

        <form method="post" action="/Cart/Checkout">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn-checkout">
            Tiến Hành Đặt Hàng →
          </button>
        </form>

        <div class="shipping-note">
          <strong>Ưu đãi:</strong> Miễn phí vận chuyển toàn quốc cho đơn hàng từ <strong>500.000 ₫</strong>!
        </div>
      </aside>
    </div>
  }
</main>
