@model AutoGarageMVC.Models.ViewModels.ProfileVM
@{
    ViewBag.Title = "Thông Tin Cá Nhân";
    var initial = !string.IsNullOrEmpty(Model.Name) ? Model.Name.Substring(0, 1).ToUpper() : "U";
}

@section Styles {
  <link rel="stylesheet" href="~/css/auth.css" />
  <link rel="stylesheet" href="~/css/cart.css" />
}

<main class="profile-wrapper" style="max-width:1100px;margin:40px auto;display:grid;grid-template-columns:260px 1fr;gap:30px;padding:0 20px;">
  <aside class="profile-sidebar" style="background:#fff;padding:24px;border-radius:12px;border:1px solid #eee;height:fit-content;text-align:center;">
    <div class="profile-avatar" style="width:70px;height:70px;background:#e63946;color:#fff;font-size:28px;font-weight:700;display:flex;align-items:center;justify-content:center;border-radius:50%;margin:0 auto 12px;">@initial</div>
    <h3 style="margin:0 0 4px">@Model.Name</h3>
    <p class="muted" style="color:#777;font-size:13px;margin:0 0 20px">@Model.Email</p>

    <nav class="profile-nav" style="display:flex;flex-direction:column;gap:8px;text-align:left;">
      <a href="javascript:void(0)" class="profile-nav-item active" onclick="showPanel('info', this)" style="padding:10px 14px;border-radius:6px;text-decoration:none;color:#333;font-weight:600;display:flex;align-items:center;gap:8px;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        Thông tin cá nhân
      </a>
      <a href="javascript:void(0)" class="profile-nav-item" onclick="showPanel('password', this)" style="padding:10px 14px;border-radius:6px;text-decoration:none;color:#555;font-weight:600;display:flex;align-items:center;gap:8px;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        Đổi mật khẩu
      </a>
      <a href="javascript:void(0)" class="profile-nav-item" onclick="showPanel('orders', this)" style="padding:10px 14px;border-radius:6px;text-decoration:none;color:#555;font-weight:600;display:flex;align-items:center;gap:8px;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
        Lịch sử đơn hàng (@Model.Orders.Count)
      </a>
      <hr style="border:0;border-top:1px solid #eee;margin:10px 0" />
      <form method="post" action="/Auth/Logout">
        @Html.AntiForgeryToken()
        <button type="submit" style="width:100%;text-align:left;background:none;border:none;padding:10px 14px;color:#e63946;cursor:pointer;font-weight:600;font-size:14px;display:flex;align-items:center;gap:8px;">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          Đăng xuất
        </button>
      </form>
    </nav>
  </aside>

  <section class="profile-content" style="background:#fff;padding:30px;border-radius:12px;border:1px solid #eee;">
    <!-- PANEL: THÔNG TIN CÁ NHÂN -->
    <div class="panel" id="panel-info">
      <h2 style="margin-top:0;margin-bottom:8px">Thông Tin Cá Nhân</h2>
      <p style="color:#666;font-size:14px;margin-bottom:24px">Cập nhật họ tên, số điện thoại của bạn.</p>

      <form method="post" action="/Profile/UpdateInfo" style="max-width:500px">
        @Html.AntiForgeryToken()
        <div class="form-group" style="margin-bottom:16px">
          <label style="display:block;margin-bottom:6px;font-weight:600;font-size:13px">Họ và tên</label>
          <input asp-for="Name" style="width:100%;padding:10px 12px;border:1px solid #ddd;border-radius:6px" required />
        </div>
        <div class="form-group" style="margin-bottom:16px">
          <label style="display:block;margin-bottom:6px;font-weight:600;font-size:13px">Số điện thoại</label>
          <input asp-for="Phone" style="width:100%;padding:10px 12px;border:1px solid #ddd;border-radius:6px" required />
        </div>
        <div class="form-group" style="margin-bottom:24px">
          <label style="display:block;margin-bottom:6px;font-weight:600;font-size:13px">Email (Không thể thay đổi)</label>
          <input asp-for="Email" style="width:100%;padding:10px 12px;border:1px solid #ddd;border-radius:6px;background:#f9f9f9" readonly />
        </div>
        <button type="submit" class="btn-primary" style="padding:10px 24px;border-radius:6px">Lưu Thay Đổi</button>
      </form>
    </div>

    <!-- PANEL: ĐỔI MẬT KHẨU -->
    <div class="panel" id="panel-password" style="display:none">
      <h2 style="margin-top:0;margin-bottom:8px">Đổi Mật Khẩu</h2>
      <p style="color:#666;font-size:14px;margin-bottom:24px">Để bảo mật tài khoản, vui lòng sử dụng mật khẩu từ 6 ký tự trở lên.</p>

      <form method="post" action="/Profile/ChangePassword" style="max-width:500px">
        @Html.AntiForgeryToken()
        <div class="form-group" style="margin-bottom:16px">
          <label style="display:block;margin-bottom:6px;font-weight:600;font-size:13px">Mật khẩu hiện tại</label>
          <input type="password" name="oldPassword" style="width:100%;padding:10px 12px;border:1px solid #ddd;border-radius:6px" required />
        </div>
        <div class="form-group" style="margin-bottom:16px">
          <label style="display:block;margin-bottom:6px;font-weight:600;font-size:13px">Mật khẩu mới</label>
          <input type="password" name="newPassword" minlength="6" style="width:100%;padding:10px 12px;border:1px solid #ddd;border-radius:6px" required />
        </div>
        <div class="form-group" style="margin-bottom:24px">
          <label style="display:block;margin-bottom:6px;font-weight:600;font-size:13px">Xác nhận mật khẩu mới</label>
          <input type="password" name="confirmPassword" minlength="6" style="width:100%;padding:10px 12px;border:1px solid #ddd;border-radius:6px" required />
        </div>
        <button type="submit" class="btn-primary" style="padding:10px 24px;border-radius:6px">Cập Nhật Mật Khẩu</button>
      </form>
    </div>

    <!-- PANEL: LỊCH SỬ ĐƠN HÀNG -->
    <div class="panel" id="panel-orders" style="display:none">
      <h2 style="margin-top:0;margin-bottom:8px">Lịch Sử Đơn Hàng</h2>
      <p style="color:#666;font-size:14px;margin-bottom:24px">Danh sách các đơn hàng phụ kiện đã đặt tại AutoGarage.</p>

      @if (!Model.Orders.Any())
      {
        <div style="text-align:center;padding:40px;color:#888">
          <div style="margin-bottom:12px;color:#999">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.6 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path>
            </svg>
          </div>
          <p>Bạn chưa có đơn hàng nào.</p>
          <a href="/Accessories" class="btn-primary" style="display:inline-block;margin-top:10px">Khám phá phụ kiện</a>
        </div>
      }
      else
      {
        <div style="display:flex;flex-direction:column;gap:16px">
          @foreach (var o in Model.Orders)
          {
            <div style="border:1px solid #eee;border-radius:8px;padding:16px;background:#fafafa">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;border-bottom:1px solid #eee;padding-bottom:8px">
                <div>
                  <strong style="color:#111;font-size:15px">@o.OrderCode</strong>
                  <span style="font-size:13px;color:#777;margin-left:10px">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <span style="background:#e3f2fd;color:#1976d2;padding:4px 10px;border-radius:20px;font-size:12px;font-weight:600">Đã tiếp nhận</span>
              </div>
              <div style="margin-bottom:12px">
                @foreach (var it in o.Items)
                {
                  <div style="display:flex;justify-content:space-between;font-size:13px;color:#444;margin-bottom:4px">
                    <span>@it.Qty × @it.Name</span>
                    <span>@((it.Price * it.Qty).ToString("N0")) ₫</span>
                  </div>
                }
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;font-size:14px;border-top:1px dashed #ddd;padding-top:8px">
                <span style="color:#666">Tổng tiền:</span>
                <strong style="color:#e63946;font-size:16px">@o.Total.ToString("N0") ₫</strong>
              </div>
            </div>
          }
        </div>
      }
    </div>
  </section>
</main>

@section Scripts {
  <script>
    function showPanel(panelName, el) {
      document.querySelectorAll('.panel').forEach(p => p.style.display = 'none');
      document.querySelectorAll('.profile-nav-item').forEach(i => {
        i.style.color = '#555';
        i.style.background = 'none';
      });

      document.getElementById('panel-' + panelName).style.display = 'block';
      el.style.color = '#333';
      el.style.background = '#f0f0f0';
    }
  </script>
}
