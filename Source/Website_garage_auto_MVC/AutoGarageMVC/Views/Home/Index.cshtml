@{
    ViewBag.Title = "Trang chủ — AutoGarage";
}

<!-- HERO BANNER -->
<section class="hero-banner">
  <img class="hero-img" src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1600&q=80" alt="Hero banner" />
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1 class="hero-title">Khám Phá Thế Giới Xe Hơi</h1>
    <p class="hero-subtitle">Hệ thống showroom ô tô chính hãng — Phụ kiện cao cấp — Xưởng dịch vụ tận tâm.</p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
      <a href="/Cars" class="hero-btn hero-btn-primary">Xem Danh Sách Xe</a>
      <a href="/Accessories" class="hero-btn hero-btn-outline">Khám Phá Phụ Kiện</a>
    </div>
  </div>
</section>

<!-- FLASH SALE -->
<section class="flash-sale">
  <div class="flash-inner">
    <div class="flash-content">
      <span class="flash-badge">FLASH SALE</span>
      <h2>Ưu Đãi <span class="highlight">30%</span> Toàn Bộ Phụ Kiện</h2>
      <p>Chương trình kết thúc sau — nhanh tay nhận mã giảm giá và đặt hàng ngay hôm nay!</p>
      <div class="countdown" id="countdown">
        <div class="count-box"><span class="count-num" id="cd-days">00</span><span class="count-label">Ngày</span></div>
        <div class="count-box"><span class="count-num" id="cd-hours">00</span><span class="count-label">Giờ</span></div>
        <div class="count-box"><span class="count-num" id="cd-mins">00</span><span class="count-label">Phút</span></div>
        <div class="count-box"><span class="count-num" id="cd-secs">00</span><span class="count-label">Giây</span></div>
      </div>
    </div>
    <div class="flash-coupon">
      <div class="flash-coupon-label">Mã giảm giá</div>
      <div class="flash-coupon-code">SALE30</div>
      <div class="flash-coupon-desc">Giảm 30% cho đơn hàng phụ kiện</div>
      <button class="flash-coupon-btn" id="copy-coupon-btn" type="button" onclick="navigator.clipboard.writeText('SALE30');alert('Đã sao chép mã SALE30!')">Sao chép mã</button>
    </div>
  </div>
</section>

<!-- MỤC BẢN TIN MỚI NHẤT -->
<section id="news-section" class="section" style="max-width:1200px;margin:50px auto;padding:0 20px;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:28px">
    <div>
      <h2 style="font-size:26px;margin:0 0 6px;color:#1a1a1a">Bản Tin Mới Nhất</h2>
