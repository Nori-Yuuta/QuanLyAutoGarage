    <article style="background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.06);transition:0.3s;display:flex;flex-direction:column;border:1px solid #eee">
      <div style="height:170px;background:#f5f5f7;display:flex;align-items:center;justify-content:center;color:#1a1a1a">
        <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="#1a1a1a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
        </svg>
      </div>
      <div style="padding:22px;flex:1;display:flex;flex-direction:column">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
          <span style="background:#eee;color:#333;font-size:12px;font-weight:700;padding:3px 8px;border-radius:4px">Kinh Nghiệm</span>
          <span style="font-size:12px;color:#888">12/11/2024</span>
        </div>
        <h3 style="font-size:17px;line-height:1.4;margin:0 0 10px;color:#1a1a1a">
          5 Phụ Kiện Ô Tô Không Thể Thiếu Khi Mua Xe Mới
        </h3>
        <p style="font-size:13px;color:#666;line-height:1.6;margin:0 0 16px;flex:1">
