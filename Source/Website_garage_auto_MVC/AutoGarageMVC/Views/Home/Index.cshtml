        <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="#1a1a1a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 17h14M5 17l1.5-6.5A2 2 0 0 1 8.4 9h7.2a2 2 0 0 1 1.9 1.5L19 17M5 17v3M19 17v3"></path>
          <circle cx="7.5" cy="19" r="1.5"></circle>
          <circle cx="16.5" cy="19" r="1.5"></circle>
        </svg>
      </div>
      <div style="padding:22px;flex:1;display:flex;flex-direction:column">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
          <span style="background:#eee;color:#333;font-size:12px;font-weight:700;padding:3px 8px;border-radius:4px">Xe Mới</span>
          <span style="font-size:12px;color:#888">15/11/2024</span>
