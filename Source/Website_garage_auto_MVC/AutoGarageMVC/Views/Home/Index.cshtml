    </div>
    <a href="/Home/News" style="color:#e63946;text-decoration:none;font-weight:700;font-size:14px">Xem tất cả tin tức →</a>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:24px">
