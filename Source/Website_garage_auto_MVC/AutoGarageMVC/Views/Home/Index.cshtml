          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <div style="padding:22px;flex:1;display:flex;flex-direction:column">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
          <span style="background:#eee;color:#333;font-size:12px;font-weight:700;padding:3px 8px;border-radius:4px">Công Nghệ</span>
          <span style="font-size:12px;color:#888">08/11/2024</span>
        </div>
        <h3 style="font-size:17px;line-height:1.4;margin:0 0 10px;color:#1a1a1a">
          Xu Hướng Xe Hybrid Và Xe Điện Tại Thị Trường Việt Nam 2024
        </h3>
        <p style="font-size:13px;color:#666;line-height:1.6;margin:0 0 16px;flex:1">
          Hạ tầng trạm sạc cùng chính sách ưu đãi thuế đang mở ra kỷ nguyên mới cho các dòng xe điện và Hybrid bảo vệ môi trường tại Việt Nam.
        </p>
        <a href="/Home/News" style="color:#1a1a1a;font-weight:700;font-size:13px;text-decoration:none">Đọc chi tiết →</a>
      </div>
    </article>
  </div>
</section>

<!-- MỤC THÔNG TIN CỬA HÀNG -->
