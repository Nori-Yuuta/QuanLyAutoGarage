<!-- DỊCH VỤ CỦA CHÚNG TÔI -->
<section style="background:#f8f9fa;padding:60px 20px;">
  <div style="max-width:1200px;margin:0 auto">
    <div style="text-align:center;margin-bottom:40px">
      <h2 style="font-size:26px;margin:0 0 10px;color:#1a1a1a">Dịch Vụ Tại AutoGarage</h2>
      <p style="color:#666">Chăm sóc toàn diện cho chiếc xe của bạn theo tiêu chuẩn quốc tế</p>
    </div>
