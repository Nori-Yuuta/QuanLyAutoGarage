@model List<AutoGarageMVC.Models.Entities.News>
@{
    ViewBag.Title = "Bản Tin & Kiến Thức Ô Tô";
    var selectedCat = ViewBag.SelectedCategory as string;
    var search = ViewBag.Search as string;
}

@section Styles {
  <link rel="stylesheet" href="~/css/page.css" />
  <style>
    .news-filter-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 30px;
      padding: 16px 20px;
      background: #fff;
      border-radius: 12px;
      border: 1px solid #eee;
    }
    .cat-pills {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .cat-pill {
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      color: #555;
      background: #f4f4f4;
      transition: 0.2s;
    }
    .cat-pill:hover, .cat-pill.active {
      background: #1a1a1a;
      color: #fff;
    }
    .news-search-box {
      display: flex;
      gap: 8px;
    }
    .news-search-input {
      padding: 8px 14px;
      border: 1px solid #ddd;
      border-radius: 20px;
      font-size: 13px;
      outline: none;
      width: 220px;
    }
    .news-search-btn {
      background: #1a1a1a;
      color: #fff;
      border: none;
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 13px;
      cursor: pointer;
      font-weight: 600;
    }
    .news-card-link {
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      height: 100%;
    }
  </style>
}

<main class="page-wrapper">
  <section class="page-hero">
    <div class="page-hero-content">
      <span class="page-hero-badge">BẢN TIN CHUYÊN NGÀNH</span>
      <h1>Tin Tức & Kinh Nghiệm Xe Hơi</h1>
      <p>Cập nhật liên tục xu hướng thị trường ô tô, kỹ năng lái xe và cẩm nang bảo dưỡng xế cưng chuẩn chuyên gia.</p>
    </div>
  </section>

  <section class="page-section" style="max-width:1200px;margin:0 auto;padding:40px 20px;">
    <!-- THANH LỌC DANH MỤC & TÌM KIẾM -->
    <div class="news-filter-bar">
      <div class="cat-pills">
        <a href="/Home/News" class="cat-pill @(string.IsNullOrEmpty(selectedCat) ? "active" : "")">Tất cả</a>
        <a href="/Home/News?category=Xe%20Mới" class="cat-pill @(selectedCat == "Xe Mới" ? "active" : "")">Xe Mới</a>
        <a href="/Home/News?category=Kinh%20Nghiệm" class="cat-pill @(selectedCat == "Kinh Nghiệm" ? "active" : "")">Kinh Nghiệm</a>
        <a href="/Home/News?category=Công%20Nghệ" class="cat-pill @(selectedCat == "Công Nghệ" ? "active" : "")">Công Nghệ</a>
        <a href="/Home/News?category=Bảo%20Dưỡng" class="cat-pill @(selectedCat == "Bảo Dưỡng" ? "active" : "")">Bảo Dưỡng</a>
        <a href="/Home/News?category=Sự%20Kiện" class="cat-pill @(selectedCat == "Sự Kiện" ? "active" : "")">Sự Kiện</a>
      </div>

      <form method="get" action="/Home/News" class="news-search-box">
        @if (!string.IsNullOrEmpty(selectedCat))
        {
          <input type="hidden" name="category" value="@selectedCat" />
        }
        <input type="text" name="search" class="news-search-input" placeholder="Tìm kiếm tin tức..." value="@search" />
        <button type="submit" class="news-search-btn">Tìm</button>
      </form>
    </div>

    @if (!Model.Any())
    {
      <div style="text-align:center;padding:60px 20px;background:#fff;border-radius:12px;border:1px solid #eee">
        <p style="color:#777;font-size:16px;margin-bottom:12px">Không tìm thấy bản tin nào phù hợp với điều kiện tìm kiếm.</p>
        <a href="/Home/News" class="cat-pill active" style="display:inline-block">Xem tất cả tin tức</a>
      </div>
    }
    else
    {
      <div class="news-grid">
        @foreach (var item in Model)
        {
          <article class="news-card" style="transition:0.3s;box-shadow:0 4px 15px rgba(0,0,0,0.05);border:1px solid #eee;overflow:hidden;border-radius:12px;display:flex;flex-direction:column;">
            <a href="/Home/NewsDetail/@item.Id" class="news-card-link">
              @if (!string.IsNullOrEmpty(item.ImageUrl))
              {
                <div style="height:200px;overflow:hidden;background:#f5f5f5">
                  <img src="@item.ImageUrl" alt="@item.Title" style="width:100%;height:100%;object-fit:cover;display:block" />
                </div>
              }
              else
              {
                <div class="news-img" style="background:#f5f5f7;height:200px;display:flex;align-items:center;justify-content:center;color:#1a1a1a">
                  <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="#1a1a1a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                  </svg>
                </div>
              }
              <div class="news-body" style="padding:22px;flex:1;display:flex;flex-direction:column">
                <div class="news-meta" style="margin-bottom:10px;display:flex;justify-content:space-between;font-size:12px;color:#888">
                  <span class="news-tag" style="background:#eee;color:#333;font-weight:700;padding:2px 8px;border-radius:4px">@item.Category</span>
                  <span class="news-date">@item.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>
                <h2 class="news-title" style="font-size:18px;line-height:1.4;margin:0 0 10px;color:#1a1a1a">@item.Title</h2>
                <p class="news-desc" style="font-size:13px;color:#666;line-height:1.6;margin:0 0 16px;flex:1">
                  @item.Summary
                </p>
                <div style="display:flex;justify-content:space-between;align-items:center;padding-top:10px;border-top:1px solid #f0f0f0;font-size:12px;color:#999">
                  <span>Lượt xem: @item.Views</span>
                  <span style="color:#1a1a1a;font-weight:700">Đọc bài viết →</span>
                </div>
              </div>
            </a>
          </article>
        }
      </div>
    }
  </section>
</main>
