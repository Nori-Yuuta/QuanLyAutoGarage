@{
    ViewBag.Title = "Thông Tin Cửa Hàng & Dịch Vụ";
}

@section Styles {
  <link rel="stylesheet" href="~/css/page.css" />
}

<main class="page-wrapper">
  <section class="page-hero">
    <div class="page-hero-content">
      <span class="page-hero-badge">VỀ CHÚNG TÔI</span>
      <h1>AutoGarage — Đam Mê Xe Hơi Từ 2010</h1>
      <p>Hơn một thập kỷ đồng hành cùng hàng triệu khách hàng Việt trên mọi nẻo đường.</p>
    </div>
  </section>

  <section class="page-section">
    <div class="about-grid">
      <div class="about-text">
        <h2>Câu Chuyện Của Chúng Tôi</h2>
        <p>
          AutoGarage ra đời năm 2010 với sứ mệnh mang đến cho người Việt những chiếc xe
          chất lượng quốc tế cùng dịch vụ chăm sóc tận tâm. Từ một garage nhỏ tại Sài Gòn,
          chúng tôi đã phát triển thành hệ thống phân phối xe và phụ kiện ô tô hàng đầu
          với hơn 20 showroom trên toàn quốc.
        </p>
        <p>
          Chúng tôi tin rằng chiếc xe không chỉ là phương tiện di chuyển, mà là người bạn
          đồng hành tin cậy, là không gian riêng tư của mỗi gia đình. Vì vậy, từng sản phẩm
          và dịch vụ tại AutoGarage đều được chọn lọc và kiểm định nghiêm ngặt theo tiêu chuẩn cao nhất.
        </p>

        <div class="stats-row">
          <div class="stat-item">
            <span class="stat-num">14+</span>
            <span class="stat-label">Năm kinh nghiệm</span>
          </div>
          <div class="stat-item">
            <span class="stat-num">50.000+</span>
            <span class="stat-label">Khách hàng tin tưởng</span>
          </div>
          <div class="stat-item">
            <span class="stat-num">20+</span>
            <span class="stat-label">Showroom toàn quốc</span>
          </div>
          <div class="stat-item">
            <span class="stat-num">98%</span>
            <span class="stat-label">Độ hài lòng</span>
          </div>
        </div>
      </div>
      <div class="about-image">
        <img src="https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=800&q=80"
             alt="Showroom AutoGarage" />
      </div>
    </div>
  </section>

  <!-- DỊCH VỤ GARAGE (ANCHOR #services) -->
  <section id="services" class="page-section" style="background:#f8f9fa;padding:60px 20px;">
    <div style="max-width:1200px;margin:0 auto">
      <div style="text-align:center;margin-bottom:40px">
        <h2 style="font-size:28px;margin:0 0 10px">Các Dịch Vụ Chuyên Nghiệp Tại AutoGarage</h2>
        <p style="color:#666">Trang thiết bị chẩn đoán hiện đại bậc nhất cùng linh kiện chính hãng</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:24px">
        <div style="background:#fff;padding:30px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,0.05);border-top:4px solid #1a1a1a">
          <div style="margin-bottom:15px;color:#1a1a1a">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          </div>
          <h3 style="font-size:18px;margin-bottom:10px">Bảo Dưỡng Định Kỳ</h3>
          <p style="color:#666;font-size:14px;line-height:1.6">
            Kiểm tra tổng quát 30 hạng mục: động cơ, hệ thống phanh, dầu máy, lọc gió, nước làm mát theo khuyến cáo từ nhà sản xuất.
          </p>
        </div>

        <div style="background:#fff;padding:30px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,0.05);border-top:4px solid #1a1a1a">
          <div style="margin-bottom:15px;color:#1a1a1a">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"/>
            </svg>
          </div>
          <h3 style="font-size:18px;margin-bottom:10px">Đồng Sơn & Sửa Chữa</h3>
          <p style="color:#666;font-size:14px;line-height:1.6">
            Phòng sơn sấy tiêu chuẩn quốc tế, pha màu vi tính chính xác 100%, phục hồi va chạm và bảo hành bong tróc sơn đến 3 năm.
          </p>
        </div>

        <div style="background:#fff;padding:30px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,0.05);border-top:4px solid #1a1a1a">
          <div style="margin-bottom:15px;color:#1a1a1a">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/>
            </svg>
          </div>
          <h3 style="font-size:18px;margin-bottom:10px">Chăm Sóc Xe Detailing</h3>
          <p style="color:#666;font-size:14px;line-height:1.6">
            Đánh bóng sơn nhiều bước, phủ Ceramic/Graphene 9H, vệ sinh khoang máy và nội thất sâu bằng hơi nước nóng diệt khuẩn.
          </p>
        </div>

        <div style="background:#fff;padding:30px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,0.05);border-top:4px solid #1a1a1a">
          <div style="margin-bottom:15px;color:#1a1a1a">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
            </svg>
          </div>
          <h3 style="font-size:18px;margin-bottom:10px">Cứu Hộ Giao Thông 24/7</h3>
          <p style="color:#666;font-size:14px;line-height:1.6">
            Đội ngũ cứu hộ chuyên nghiệp ứng trực 24/7, kích bình ắc quy, thay lốp dự phòng hoặc cẩu kéo xe về xưởng dịch vụ an toàn.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- GIÁ TRỊ CỐT LÕI -->
  <section class="page-section page-section-alt">
    <h2 class="section-title">Giá Trị Cốt Lõi</h2>
    <p class="section-subtitle">Những nguyên tắc dẫn dắt mọi quyết định của chúng tôi</p>

    <div class="values-grid">
      <div class="value-card">
        <div class="value-icon">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
        </div>
        <h3>Chất Lượng Tiên Phong</h3>
        <p>Mọi dòng xe và phụ kiện đều có nguồn gốc rõ ràng, giấy tờ đầy đủ và bảo hành chính hãng.</p>
      </div>

      <div class="value-card">
        <div class="value-icon">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </div>
        <h3>Tận Tâm Phục Vụ</h3>
        <p>Đội ngũ chuyên viên tư vấn luôn lắng nghe, thấu hiểu nhu cầu để đưa ra giải pháp phù hợp nhất.</p>
      </div>

      <div class="value-card">
        <div class="value-icon">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line><circle cx="12" cy="12" r="5"></circle></svg>
        </div>
        <h3>Đổi Mới Không Ngừng</h3>
        <p>Cập nhật liên tục các mẫu xe mới nhất, công nghệ tiên tiến và phụ kiện hiện đại trên thế giới.</p>
      </div>

      <div class="value-card">
        <div class="value-icon">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <h3>Đồng Hành Dài Lâu</h3>
        <p>Chính sách hậu mãi chu đáo, hỗ trợ bảo dưỡng định kỳ và dịch vụ cứu hộ 24/7 trên toàn quốc.</p>
      </div>
    </div>
  </section>
</main>
